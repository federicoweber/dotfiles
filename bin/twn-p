#!/usr/bin/env bash
# Email Hub multi-checkout helper.
#
# For plain/`-r` usage, prints the target directory on stdout so a shell
# wrapper function can `cd` into it. For `-t`/`--tmux`, builds a 3-window
# tmux layout (claude, dev, gh dash) and exits without printing anything.

set -euo pipefail

print_help() {
  cat <<'EOF'
Usage: twn-p <N> [options]

Switch to (or create) the townN multi-checkout project directory.

Arguments:
  N               Checkout number (e.g. 1, 2, 3)

Options:
  -r, --run       After cd, start the local convex backend
  -t, --tmux      Open a 3-window tmux layout for this project:
                    - TWN_N      claude (left); right column has live
                                 `git diff HEAD` via viddy on top and
                                 a free shell on the bottom
                    - TWN_N_dash `ghd` (gh dash filtered to current branch)
                    - TWN_N_dev  side-by-side panes
                        - left:  `twn-p N --run` (local convex backend)
                        - right: free shell
                  Outside tmux: attaches to an existing TWN_N session
                  if one exists, otherwise creates a new session
                  named TWN_N.
                  Inside tmux: creates the windows in the current session.
                  If townN hasn't been checked out yet, only TWN_N opens
                  to run the setup script; the dev and dash windows are
                  created once setup succeeds.
  -k, --kill      Kill the TWN_N tmux session. Works from inside or
                  outside the session (killing the session you're
                  attached to will detach you).
  -h, --help      Show this help

Examples:
  twn-p 2             cd to town2 in the current shell
  twn-p 2 --run       same, then start the local convex backend
  twn-p 2 --tmux      open the 3-window tmux layout for town2
  twn-p 2 --kill      kill the TWN_2 tmux session
EOF
}

if [ $# -eq 0 ]; then
  print_help >&2
  exit 1
fi

case "$1" in
  -h|--help) print_help; exit 0 ;;
esac

num="$1"
shift
use_tmux=false
use_kill=false
while [ $# -gt 0 ]; do
  case "$1" in
    -t|--tmux) use_tmux=true ;;
    -k|--kill) use_kill=true ;;
    -r|--run) ;;  # handled by the shell wrapper (needs shell state)
    -h|--help) print_help; exit 0 ;;
    *) echo "twn-p: unknown option: $1" >&2; exit 1 ;;
  esac
  shift
done

if $use_kill; then
  if $use_tmux; then
    echo "twn-p: --kill cannot be combined with --tmux" >&2
    exit 1
  fi
  command -v tmux >/dev/null 2>&1 || { echo "twn-p: tmux not found" >&2; exit 1; }
  name="TWN_$num"
  if ! tmux has-session -t "=$name" 2>/dev/null; then
    echo "twn-p: no tmux session named $name" >&2
    exit 1
  fi
  # Kill in the background so, if we're being killed along with our own
  # session, the foreground command still returns cleanly before tmux tears
  # the client down.
  (tmux kill-session -t "=$name" >/dev/null 2>&1 &) 2>/dev/null
  exit 0
fi

: "${TOWN_EMAIL_HUB_PROJECTS:=$HOME/town_projects}"
dir="$TOWN_EMAIL_HUB_PROJECTS/town$num"

if ! $use_tmux; then
  if [ ! -d "$dir" ]; then
    (cd "$HOME/email-hub" && scripts/setup-multi-checkout.sh -n "$num" --root-projects-dir "$TOWN_EMAIL_HUB_PROJECTS") >&2
  fi
  printf '%s\n' "$dir"
  exit 0
fi

# --- --tmux: build the tmux layout ---------------------------------------
command -v tmux >/dev/null 2>&1 || { echo "twn-p: tmux not found" >&2; exit 1; }
name="TWN_$num"
needs_setup=false
[ -d "$dir" ] || needs_setup=true

# When the target dir doesn't exist yet, start the pane in email-hub so the
# setup script is right there; otherwise start in the project dir.
if $needs_setup; then
  start_dir="$HOME/email-hub"
else
  start_dir="$dir"
fi

attach_target=""
if [ -n "${TMUX:-}" ]; then
  tmux new-window -n "$name" -c "$start_dir"
  p0=$(tmux display-message -p '#{pane_id}')
elif tmux has-session -t "=$name" 2>/dev/null; then
  # A session with this exact name already exists — just attach to it.
  tmux attach-session -t "$name"
  exit 0
else
  # No TWN_N session yet — create one. If another tmux server is already
  # running, this new session lives alongside the existing ones.
  p0=$(tmux new-session -d -s "$name" -n "$name" -c "$start_dir" -P -F '#{pane_id}')
  attach_target="$name"
fi

build_layout() {
  local p0="$1" sess win0 diff_pane dev_p0
  read -r sess win0 < <(tmux display-message -p -t "$p0" '#{session_id} #{window_id}')

  # Window 1: claude on the left (60%); right column (40%) split into
  # viddy `git diff HEAD` on top (2/3) and a free shell on the bottom (1/3).
  diff_pane=$(tmux split-window -h -l 40% -t "$p0" -c "$dir" -P -F '#{pane_id}')
  tmux split-window -v -l 33% -t "$diff_pane" -c "$dir"
  tmux send-keys -t "$diff_pane" "viddy -n 2 'git -c color.ui=always --no-pager diff HEAD'" C-m
  tmux send-keys -t "$p0" 'clear && claude' C-m
  tmux select-pane -t "$p0"

  # Window 2: gh dash filtered to the current branch.
  tmux new-window -t "$sess:" -n "${name}_dash" -c "$dir" "ghd"

  # Window 3: dev — convex backend (left) + free shell (right), side-by-side.
  dev_p0=$(tmux new-window -t "$sess:" -n "${name}_dev" -c "$dir" -P -F '#{pane_id}')
  tmux split-window -h -l 50% -t "$dev_p0" -c "$dir"
  tmux send-keys -t "$dev_p0" "twn-p $num --run" C-m

  # Focus back on window 1 (claude).
  tmux select-window -t "$win0"
}

if $needs_setup; then
  # Run setup inside the pane so the user sees it, then signal a wait channel.
  # A backgrounded waiter builds the dev and dash windows once setup
  # succeeds, leaving the user free to watch the setup pane in the meantime.
  signal="twnp_${num}_$$"
  setup_cmd="scripts/setup-multi-checkout.sh -n $num --root-projects-dir \"\$TOWN_EMAIL_HUB_PROJECTS\" && cd \"$dir\"; tmux wait-for -S $signal"

  # Start the waiter BEFORE sending the signal command — tmux channel signals
  # are not buffered, so the waiter must be armed first.
  (
    tmux wait-for "$signal" 2>/dev/null || exit 0
    [ -d "$dir" ] || exit 0
    build_layout "$p0"
  ) &
  disown 2>/dev/null || true

  tmux send-keys -t "$p0" "$setup_cmd" C-m

  if [ -z "${TMUX:-}" ]; then
    tmux attach-session -t "$attach_target"
  fi
  exit 0
fi

# Dir already exists: build the layout right away.
build_layout "$p0"
if [ -z "${TMUX:-}" ]; then
  tmux attach-session -t "$name"
fi
exit 0
